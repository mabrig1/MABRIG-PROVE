{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "mabrig-prove",
  "main": "./worker/index.mjs",
  "compatibility_date": "2026-11-14",
  "assets": {
    "directory": "./public",
    "binding": "ASSETS",
    "run_worker_first": ["/api/*"],
    "not_found_handling": "single-page-application"
  },
  "vars": {
    "PROVE_WRITE_MODE": "locked"
  },
  "triggers": {"crons":["0 3 * * *"]},
  "observability": {
    "enabled": true
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "mabrig-prove-db",
      "database_id": "e20f095e-ed02-42ca-af68-b2e62de7dcca"
    }
  ]
  // Optional later: after creating a private R2 bucket, configure:
  // "r2_buckets": [{"binding":"EVIDENCE","bucket_name":"mabrig-prove-private-evidence"}]
}

