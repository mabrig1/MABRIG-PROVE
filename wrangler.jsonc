{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "mabrig-prove",
  "main": "./worker/index.mjs",
  "compatibility_date": "2026-11-14",
  "assets": {
    "directory": "./public",
    "binding": "ASSETS",
    "run_worker_first": ["/api/*"],
    "not_found_handling": "single-page-application"
  },
  "vars": {
    "PROVE_WRITE_MODE": "locked"
  },
  "triggers": {"crons":["0 3 * * *"]},
  "observability": {
    "enabled": true
  }
  // Add your actual D1/R2 binding IDs only after creating those resources.
  // "d1_databases": [{"binding":"DB","database_name":"mabrig-prove-db","database_id":"YOUR_DATABASE_ID"}],
  // "r2_buckets": [{"binding":"EVIDENCE","bucket_name":"mabrig-prove-private-evidence"}]
}

